# Copy to .env (never committed) and fill in. Read by the /api functions only;
# none of these reach the browser. On Vercel, set them under Project Settings, Environment Variables.

# Required for the AI features (Describe the job, Read drawing).
OPENAI_API_KEY=

# Optional. Model used for both features. Must accept images and structured outputs.
OPENAI_MODEL=gpt-6-astra

# Optional. minimal, low, medium or high for reasoning models. Default low.
OPENAI_REASONING_EFFORT=

# Optional. When set, the app asks for this code before using the AI features,
# so a public demo URL cannot spend the API budget.
GENSPEC_ACCESS_CODE=
